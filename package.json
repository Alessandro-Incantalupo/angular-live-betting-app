{
  "name": "live-odds-angular",
  "version": "1.0.0",
  "private": true,
  "description": "Live odds demo: Angular, zoneless, NgRx Signal Store, polling against an in-browser mock API.",
  "license": "MIT",
  "author": "Alessandro Incantalupo",
  "type": "module",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test --watch=false",
    "test:watch": "ng test",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.spec.json --noEmit",
    "lint": "ng lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build && pnpm check:csp",
    "check:csp": "node scripts/check-csp.mjs",
    "preview": "pnpm build && pnpm check:csp && pnpm dlx wrangler@4 versions upload"
  },
  "dependencies": {
    "@a.incantalupo/design-tokens": "^0.1.0",
    "@angular/common": "^22.3.0",
    "@angular/compiler": "^22.3.0",
    "@angular/core": "^22.3.0",
    "@angular/platform-browser": "^22.3.0",
    "@angular/router": "^22.3.0",
    "@ngrx/operators": "^22.0.1",
    "@ngrx/signals": "^22.0.1",
    "rxjs": "~7.8.0",
    "tslib": "^2.8.0"
  },
  "devDependencies": {
    "@angular-eslint/builder": "22.8.0",
    "@angular/build": "^22.3.0",
    "@angular/cli": "^22.3.0",
    "@angular/compiler-cli": "^22.3.0",
    "@eslint/js": "^10.0.1",
    "angular-eslint": "22.8.0",
    "eslint": "^10.14.0",
    "jsdom": "^31.0.1",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "8.72.2",
    "vitest": "^5.1.1"
  },
  "packageManager": "pnpm@12.21.0"
}
